# Local environment for FindBack.
#
# Copy to .env.local and fill in the real values:
#   cp .env.example .env.local
#
# .env.local is gitignored. .env.example is committed and holds only the
# non-secret local defaults that match docker-compose.yml.

# --- Database -----------------------------------------------------------
# Host port 5433 (the host's own PostgreSQL already occupies 5432).
# Matches the docker-compose.yml service above.
DATABASE_URL="postgresql://findback:findback_dev@localhost:5433/findback?schema=public"

# --- Session ------------------------------------------------------------
# Arbitrary local value. Rotate for any non-local environment.
# 32+ characters. Rotated per environment, never shared.
# Also keys the CSRF token's HMAC, so it must be present for the identity
# endpoints to work at all.
SESSION_SECRET="local-dev-only-session-secret-change-me"

# The session inactivity window, in days (FR-4).
SESSION_INACTIVITY_DAYS="14"
# The activity-refresh threshold, in minutes (ADR-16). The effective idle
# window is therefore 13-14 days rather than exactly 14.
SESSION_ACTIVITY_REFRESH_MINUTES="60"

# The base URL of the application, used to build the approval email's login
# link. Defaults to a relative link when unset.
APP_BASE_URL="http://localhost:3000"

# --- Password hashing (ADR-12) ------------------------------------------
# Argon2id work factors. Configured, not hardcoded. The values are embedded
# in every stored hash, so raising them is a configuration change with no
# data migration and no invalidation of existing credentials.
# Defaults: 65536 KiB (64 MiB), 3 passes, parallelism 1.
# AUTH_ARGON2_MEMORY_KIB="65536"
# AUTH_ARGON2_ITERATIONS="3"
# AUTH_ARGON2_PARALLELISM="1"

# --- Rate limits (ADR-15) -----------------------------------------------
# Configured, not hardcoded, with ADR-15's chosen values as the defaults.
# An invalid value falls back to the default rather than failing the request.
#
# The login path has TWO buckets and both must pass: the IP bucket is loose
# (a campus has many members behind one address), the email bucket is tight
# (one account's failures are individually meaningful).
# AUTH_RATE_REGISTER_LIMIT="5"
# AUTH_RATE_REGISTER_WINDOW_SECONDS="3600"
# AUTH_RATE_LOGIN_IP_LIMIT="20"
# AUTH_RATE_LOGIN_IP_WINDOW_SECONDS="900"
# AUTH_RATE_LOGIN_EMAIL_LIMIT="10"
# AUTH_RATE_LOGIN_EMAIL_WINDOW_SECONDS="900"

# --- Password reset (bolt 005) -------------------------------------------
# The reset token's lifetime, in seconds (ADR-17). Default 3600 (1 hour).
# PRODUCT-VISIBLE: the reset email states this value, so a member is told
# the truth about the window they have. A malformed value falls back to the
# default rather than failing the request.
AUTH_RESET_TOKEN_TTL_SECONDS="3600"

# The minimum response time for a reset request, in milliseconds. Default 250.
# The anti-enumeration floor (ADR-18): an unconditional dummy Argon2id
# verification on every path, plus this constant floor. Applied on EVERY
# path, including the rate-limited one.
AUTH_RESET_MIN_RESPONSE_MS="250"

# The timing tolerance the acceptance test asserts, in milliseconds. Default 100.
# Wide enough not to be flaky; narrow enough that a real existence oracle
# would fail it by orders of magnitude.
AUTH_RESET_TIMING_TOLERANCE_MS="100"

# The reset request's rate limits. BOTH buckets must pass: the IP bucket is
# loose (a campus has many members behind one address), the email bucket is
# tight (three resets for one address in an hour is not a legitimate
# pattern). The email bucket's key is a KEYED DIGEST of the address, never
# the address itself (ADR-19) — an unsalted hash is trivially reversible by
# dictionary attack, because the email address space is small and well
# known.
# AUTH_RATE_RESET_IP_LIMIT="5"
# AUTH_RATE_RESET_IP_WINDOW_SECONDS="3600"
# AUTH_RATE_RESET_EMAIL_LIMIT="3"
# AUTH_RATE_RESET_EMAIL_WINDOW_SECONDS="3600"

# --- Password-reset secrets (REQUIRED) ----------------------------------
# Both are required, and a missing one FAILS AT STARTUP rather than falling
# back. The fallback for the bucket secret would be a plaintext address in
# the counter table — precisely the disclosure ADR-19 exists to prevent —
# and a deployment that appears protected but is not is worse than one that
# fails to start.
#
# The two are DISTINCT, and neither is derived from SESSION_SECRET. They
# protect different things (credentials vs. operational data), so their
# rotation schedules are independent. Rotating the bucket secret does not
# invalidate outstanding reset tokens.
#
# Per-deployment values. Never commit a real one; keep them in the
# deployment's secret store.
# AUTH_RESET_TOKEN_HASH_SECRET="..."
# AUTH_RESET_BUCKET_HASH_SECRET="..."

# --- Object storage (Vercel Blob, private) -----------------------------
# Not available locally. Image upload and delivery are therefore NOT
# click-testable in local development; they are verified by automated tests
# and reported as such. See construction-protocol.md, decision CP-4.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# --- Email --------------------------------------------------------------
# Not available locally. Emails are verified by automated tests only.
# The connection is upgraded with STARTTLS before the credentials or the
# message are sent. A relay with a private certificate authority needs its
# root here; leave it unset to use the platform's trusted roots.
# SMTP_HOST="..."
# SMTP_PORT="587"
# SMTP_USER="..."
# SMTP_PASSWORD="..."
# SMTP_TLS_CA="/etc/ssl/relay-root.pem"
# EMAIL_FROM="FindBack <no-reply@example.org>"
